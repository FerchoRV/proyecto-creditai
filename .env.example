# Copiar a .env y ajustar si hace falta. No subir .env al repo.

POSTGRES_USER=creditai
POSTGRES_PASSWORD=creditai
POSTGRES_DB=creditai
# Puerto en el host (5432 suele estar ocupado en local; 5433 evita conflicto)
POSTGRES_PORT=5433

BACKEND_PORT=8000
FRONTEND_PORT=3000

# URL que usa el navegador para llamar a la API (no el hostname interno de Docker)
NEXT_PUBLIC_API_URL=http://localhost:8000

JWT_SECRET=change-me-in-local-dev
